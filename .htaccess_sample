# PHP Backup Tool 4.0
#
# Tento soubor je jen doplňková ochrana. Nástroj je bezpečný i tam, kde hosting
# .htaccess nepoužívá (nginx) – citlivá data jsou uložena v souborech .php
# s ochrannou hlavičkou a archivy mají nezhádatelné názvy.

# --- Vypnout výpis obsahu adresářů ---------------------------------------
Options -Indexes

# --- Bezpečnostní hlavičky (jako záloha k těm, které posílá PHP) ---------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "no-referrer"
</IfModule>

# --- Adresáře data/, lib/ a views/ mají vlastní .htaccess ----------------
# (data/.htaccess si nástroj vytvoří sám při prvním spuštění)

# --- Skryté soubory a soubory verzování ----------------------------------
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# --- Volitelné: omezení na vlastní IP adresu -----------------------------
# Odkomentujte a doplňte svou adresu, chcete-li nástroj skrýt úplně.
# Stejné omezení jde nastavit i v samotném nástroji (Nastavení → Povolené IP).
#
# <RequireAny>
#     Require ip 1.2.3.4
# </RequireAny>
